FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-render-collector.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV PORT=10000 MAX_STALE_SECONDS=20 HEALTH_CHECK_INTERVAL_SECONDS=5
EXPOSE 10000
CMD ["python", "render_collector_service.py"]
